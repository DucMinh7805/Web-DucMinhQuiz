# Website / Vercel
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
MONGODB_DB_NAME=WebYKhoa
AUTH_SHEET_WEB_APP_URL=https://script.google.com/macros/s/<AUTH_DEPLOYMENT_ID>/exec
AUTH_SHEET_INTERNAL_SECRET=<random-32-characters-or-more>
SHEET_SESSION_SECRET=<different-random-32-characters-or-more>
JWT_SECRET=<legacy-only-if-needed>
CONTENT_SYNC_SECRET=<same-value-as-Sheet-len-de-Script-Property>

# Máy quản trị dùng để đồng bộ Sheet lên đề
QUIZ_SHEET_WEB_APP_URL=https://script.google.com/macros/s/<QUIZ_DEPLOYMENT_ID>/exec
QUIZ_SYNC_INTERNAL_SECRET=<same-value-as-Quiz-Apps-Script-Property>

# Chỉ URL công khai này được đóng gói xuống trình duyệt
VITE_QUIZ_DATABASE_URL=https://script.google.com/macros/s/<QUIZ_DEPLOYMENT_ID>/exec

# Chỉ dùng khi chạy `npm run dev`; mặc định trỏ tới deployment production hiện tại.
DEV_API_ORIGIN=https://web-duc-minh-quiz.vercel.app
